<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ToyFormat</RootNamespace>
    <AssemblyName>toy-format-importer</AssemblyName>
    <ImtPluginLayoutDir>$(MSBuildThisFileDirectory)../../../artifacts/plugins/com.example.toyformat</ImtPluginLayoutDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Imt.Plugin.Sdk/Imt.Plugin.Sdk.csproj" />
  </ItemGroup>
  <!-- A plugin built from the NuGet package gets this automatically (buildTransitive). -->
  <Import Project="../../../src/Imt.Plugin.Sdk/build/Imt.Plugin.Sdk.targets" />
</Project>
