<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>OrderAudit.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861;CA1849;CA2000;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/OrderAudit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="../data/orders-audit.log" CopyToOutputDirectory="PreserveNewest" Link="data/orders-audit.log" />
    <None Include="../data/expected.json" CopyToOutputDirectory="PreserveNewest" Link="data/expected.json" />
  </ItemGroup>
</Project>
