<Project>
  <!-- Central package management: every version is pinned here (exact versions). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime: Apache-2.0 (gRPC, Arrow) and BSD-3-Clause (Protobuf). -->
    <PackageVersion Include="Grpc.AspNetCore" Version="[2.84.0]" />
    <PackageVersion Include="Grpc.Tools" Version="[2.84.0]" />
    <PackageVersion Include="Google.Protobuf" Version="[3.36.2]" />
    <PackageVersion Include="Apache.Arrow" Version="[23.0.0]" />
    <!-- LZ4-frame buffer compression of Arrow IPC (Apache-2.0; K4os.Compression.LZ4 and ZstdSharp are MIT). -->
    <PackageVersion Include="Apache.Arrow.Compression" Version="[23.0.0]" />
    <!-- Tests only (never shipped): xUnit (Apache-2.0) on Microsoft.Testing.Platform (MIT), coverlet (MIT). -->
    <PackageVersion Include="xunit.v3" Version="[4.0.2]" />
    <PackageVersion Include="coverlet.MTP" Version="[10.1.0]" />
  </ItemGroup>
</Project>
