  "removed": [],
  "profile": "# Sample profile for the files in /samples. Load it from the Profile tab\n# (or copy its sections into your own). Only what differs from the built-in\n# default needs to be written: everything else falls back to the defaults.\n\nname = \"OrderService (sample)\"\n\n[instance]\nkey = [\"MachineName\", \"ProcessId\"]\n\n# The worker logs its process stats as plain text:\n#   Process stats: CPU 44.0% · WorkingSet 612 MB · Threads 84\n# This rule turns them into numeric fields. The web servers already log the\n# same numbers as Serilog properties (CpuPercent, WorkingSetMb), so they need\n# no rule.\n[[extract]]\nname = \"worker-process-stats\"\nfrom = \"@message\"\nregex = 'CPU (?P<CpuPercent>[\\d.]+)% · WorkingSet (?P<WorkingSetMb>[\\d.]+) ?(?P<ws_unit>KB|MB|GB) · Threads (?P<Threads>\\d+)'\nwhen = [{ field = \"SourceContext\", op = \"eq\", value = \"Diagnostics.ProcessMonitor\" }]\n[extract.fields]\nCpuPercent = { type = \"number\", unit = \"%\" }\nWorkingSetMb = { type = \"bytes\", unit_from = \"ws_unit\", to = \"MB\" }\nThreads = { type = \"integer\" }\n\n# Outbox backlog from \"Outbox dispatch timed out; backlog 1,204 messages\".\n[[extract]]\nname = \"outbox-backlog\"\nregex = 'backlog (?P<Backlog>[\\d,]+) messages'\n[extract.fields]\nBacklog = { type = \"integer\" }\n\n[[chart]]\nid = \"cpu\"\ntitle = \"CPU %\"\ny = \"avg(CpuPercent)\"\nbucket = \"1m\"\nsplit_by = [\"MachineName\", \"ProcessId\"]\ntype = \"line\"\nunit = \"%\"\n\n[[chart]]\nid = \"memory\"\ntitle = \"Working set\"\ny = \"max(WorkingSetMb)\"\nbucket = \"1m\"\nsplit_by = [\"MachineName\", \"ProcessId\"]\ntype = \"line\"\nunit = \"MB\"\n\n[[chart]]\nid = \"problems\"\ntitle = \"Warnings and errors\"\ny = \"count()\"\nbucket = \"1m\"\nsplit_by = [\"@level\"]\ntype = \"stacked\"\nunit = \"events\"\nwhen = [{ field = \"@level\", op = \"in\", value = \"Warning|Error|Fatal\" }]\n\n[[chart]]\nid = \"backlog\"\ntitle = \"Outbox backlog\"\ny = \"max(Backlog)\"\nbucket = \"1m\"\ntype = \"line\"\nunit = \"messages\"\n\n# \"OrderService health\": the dashboard of this profile (View → Dashboards).\n# Tiles follow the window's filters and time range unless they set a `window`.\n[[dashboard]]\nid = \"orderservice-health\"\ntitle = \"OrderService health\"\ncolumns = 12\n\n[[dashboard.tile]]\nid = \"errors\"\ntitle = \"Errors\"\ntype = \"stat\"\nquery = 'level >= error | stats count() as errors'\nw = 3\nh = 2\n\n[[dashboard.tile]]\nid = \"warnings\"\ntitle = \"Warnings\"\ntype = \"stat\"\nquery = 'level = warning | stats count() as warnings'\nx = 3\nw = 3\nh = 2\n\n[[dashboard.tile]]\nid = \"p95-latency\"\ntitle = \"p95 request time\"\ntype = \"stat\"\nquery = 'exists(Elapsed) | stats p95(Elapsed) as p95'\nunit = \"ms\"\nx = 6\nw = 3\nh = 2\n\n[[dashboard.tile]]\nid = \"backlog\"\ntitle = \"Outbox backlog (max)\"\ntype = \"stat\"\nquery = '| stats max(Backlog) as backlog'\nunit = \"messages\"\nx = 9\nw = 3\nh = 2\n\n[[dashboard.tile]]\nid = \"problems\"\ntitle = \"Warnings and errors\"\ntype = \"chart\"\nchart = \"problems\"\ny = 2\nw = 8\nh = 4\n\n[[dashboard.tile]]\nid = \"noisy-sources\"\ntitle = \"Noisiest sources (warnings and errors)\"\ntype = \"top\"\nfield = \"SourceContext\"\nquery = 'level >= warning'\nlimit = 8\nx = 8\ny = 2\nw = 4\nh = 4\n\n[[dashboard.tile]]\nid = \"cpu\"\ntitle = \"CPU %\"\ntype = \"chart\"\nchart = \"cpu\"\ny = 6\nw = 6\nh = 4\n\n[[dashboard.tile]]\nid = \"memory\"\ntitle = \"Working set\"\ntype = \"chart\"\nchart = \"memory\"\nx = 6\ny = 6\nw = 6\nh = 4\n\n[[dashboard.tile]]\nid = \"slow-endpoints\"\ntitle = \"Slowest endpoints\"\ntype = \"table\"\nquery = 'exists(Elapsed) | stats count() as requests, p95(Elapsed) as p95 by RequestPath | sort p95 desc | head 10'\ny = 10\nw = 6\nh = 4\n\n[[dashboard.tile]]\nid = \"alerts\"\ntitle = \"Alerts\"\ntype = \"alerts\"\nlimit = 10\nx = 6\ny = 10\nw = 6\nh = 4\n",
  "ui": {},
  "clock": {
    "../clock-skew/web02/requests-20261014.clef": 3742
  }
}