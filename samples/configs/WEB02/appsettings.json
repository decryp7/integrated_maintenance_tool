{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\logs\\OrderService\\orders-.clef",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Orders": "Server=SQL01;Database=Orders;Integrated Security=true;Max Pool Size=20;Connect Timeout=15"
  },
  "Payments": {
    "GatewayUrl": "https://payments-adapter:9090",
    "TimeoutMs": 5000,
    "MaxAttempts": 3
  },
  "Caching": {
    "Redis": {
      "Enabled": false
    }
  },
  "Features": {
    "NewCheckout": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 200
    }
  },
  "Diagnostics": {
    "DumpOnCrash": true,
    "DumpFolder": "C:\\ProgramData\\OrderService\\dumps"
  }
}
