{
  // UI-only tasks for when app/ is opened on its own; the repository root has the full set.
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Changes detected|Building" },
          "endsPattern": { "regexp": "bundle generation (complete|failed)|Local:\\s+http" }
        }
      }
    },
    {
      "label": "UI: unit tests",
      "type": "shell",
      "command": "npx ng test --watch=false",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "UI: lint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    }
  ]
}
