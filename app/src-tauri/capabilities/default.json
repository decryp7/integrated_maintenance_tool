{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for every IMT window (main, and w-2, w-3, ... opened later)",
  "windows": [
    "main",
    "w-*"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "log:default"
  ]
}
