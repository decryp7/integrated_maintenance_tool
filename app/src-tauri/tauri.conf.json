{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IMT",
  "version": "0.1.0",
  "identifier": "net.decryptology.imt",
  "build": {
    "frontendDist": "../dist/app/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IMT \u2014 Integrated Maintenance Tool",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Analyse logs and diagnostic files",
    "fileAssociations": [
      {
        "ext": [
          "imtproj"
        ],
        "name": "IMT Project",
        "description": "IMT analysis project",
        "role": "Editor",
        "mimeType": "application/x-imt-project"
      }
    ]
  },
  "mainBinaryName": "imt-app"
}