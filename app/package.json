{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/build-info.mjs serve",
    "build": "node scripts/build-info.mjs build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && node scripts/lint-styles.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "e2e:tauri:build": "node scripts/build-sidecars.mjs --debug && tauri build --debug --no-bundle",
    "e2e:tauri:driver": "node e2e-tauri/scripts/fetch-msedgedriver.mjs",
    "e2e:tauri": "wdio run e2e-tauri/wdio.conf.ts",
    "screenshots": "playwright test -c scripts/screenshots/playwright.config.ts",
    "i18n": "ng extract-i18n && node scripts/i18n/build-locales.mjs"
  },
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "npm@11.21.1",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ngrx/signals": "^22.0.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "dockview": "^8.6.0",
    "echarts": "^6.1.0",
    "html-to-image": "1.11.13",
    "rxjs": "~7.8.0",
    "smol-toml": "^1.9.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
