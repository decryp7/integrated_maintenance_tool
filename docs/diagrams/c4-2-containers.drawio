        <mxCell id="c3" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;The runnable units of IMT, the processes they run in and how they talk. Libraries linked into the app process are drawn inside it; plugins, the store and the AI run in their own sandboxed processes.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="82" width="1000" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b style=&quot;font-size:12px;color:#5A6375&quot;&gt;IMT&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Software system]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#5A6375;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="380" width="1700" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:12px;color:#5A6375&quot;&gt;imt-app process [Tauri 2, one per instance; a store per window]&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FAFBFC;strokeColor=#D5D9E0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=1;collapsible=0;recursiveResize=0;" parent="1" vertex="1">
          <mxGeometry x="440" y="600" width="1200" height="600" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Support engineer / Developer&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Investigates incidents, writes profiles and pipelines.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=mxgraph.c4.person2;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;align=center;verticalAlign=bottom;spacingBottom=10;spacingLeft=8;spacingRight=8;labelPadding=0;" parent="1" vertex="1">
          <mxGeometry x="920" y="130" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Plugin author&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Builds, tests and signs plugins with the Rust SDK.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=mxgraph.c4.person2;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;align=center;verticalAlign=bottom;spacingBottom=10;spacingLeft=8;spacingRight=8;labelPadding=0;" parent="1" vertex="1">
          <mxGeometry x="2240" y="130" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Installs and configures the collection agent.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=mxgraph.c4.person2;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;align=center;verticalAlign=bottom;spacingBottom=10;spacingLeft=8;spacingRight=8;labelPadding=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="1210" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Angular UI&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Angular 22, SignalStores, ECharts, dockview]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Panels, timeline, grid, inspector, jobs, notes; reaches the engine only through &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ImtBackend&lt;/span&gt;.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="920" y="420" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-plugins&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust binary, one sandboxed child process per plugin]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Serves every built-in plugin (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;--plugin &amp;lt;id&amp;gt;&lt;/span&gt;): formats, windows, web, otel, syslog, registry, tools, profiling, .NET, native, dumps.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1800" y="420" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Third-party plugins&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust, signed .imtplugin packages]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Installed by the user; strictest sandbox, only the granted permissions (ADR 0027).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="2240" y="420" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;imt-profile&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust library, pure]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Profiling engine: capture model and every profiling view.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="640" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Tauri shell (imt-app)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust, Tauri 2]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Validates IPC; windows, tray, sessions, settings, updater, jobs, notes, live tail, docked browser, AI and plugin hosting.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="920" y="640" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-ai&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust library]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Local AI: worker supervisor, models and runtimes, vision, knowledge files, research rules.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1360" y="640" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-ai-worker&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust binary, sandboxed child process]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Inference worker; supervises &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;llama-server&lt;/span&gt; (ADR 0009).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1800" y="640" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;llama-server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Prebuilt llama.cpp runtime, downloaded]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Runs the GGUF model and its vision projector (ADR 0025).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="2240" y="840" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-plugin-host&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust library, also linked into the store worker]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Starts, sandboxes and supervises plugin processes; registers proxies into the &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PluginRegistry&lt;/span&gt;.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="480" y="840" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-core&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust library, the engine]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Store and importer ports, parsers, profiles, query language, analysis, reports, plugin registry with guarded adapters.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="920" y="840" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-pdf&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust library, adapter]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PDF incident reports behind the &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ReportRenderer&lt;/span&gt; port.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1360" y="1040" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-store-worker&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust + DuckDB + Tantivy, supervised child process]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Hosts every window's store: Parquet segments, DuckDB catalog, full-text index; runs importer plugins (ADR 0014).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1800" y="840" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Download sources&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Hugging Face, GitHub releases]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GGUF models; pinned &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;llama-server&lt;/span&gt; builds.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="2240" y="640" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Gitea releases&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[dev.decryptology.net]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Signed update manifest and installers.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="40" y="640" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;OS webview&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[WebView2 / WKWebView / WebKitGTK]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Hosts the UI with a strict CSP.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="40" y="420" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Operating system&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Event Log, PDH, logman, sysinfo]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Event channels, performance counters, processes.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="1800" y="230" width="240" height="120" as="geometry" />
