        <mxCell id="mon" value='&lt;b style="font-size:13px"&gt;imt-monitor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Container: Rust library + CLI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Collector (ProcessMonitor) samples processes (sysinfo, PDH counters) and writes CLEF events. MonitorPlugin registers it; the CLI runs headless.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="admin" value='&lt;b style="font-size:13px"&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Runs the CLIs on servers and customer machines.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="1170" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="col" value='&lt;b style="font-size:13px"&gt;imt-collect&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Container: Rust library + CLI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Collector gathers app logs, event logs, msinfo32, registry keys, counters and env info, redacts text and writes an .imtz bundle.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="1160" width="280" height="160" as="geometry"/>
