<mxfile host="app.diagrams.net" agent="IMT docs" version="24.0.0">
  <diagram id="C4-2---Containers" name="C4 2 - Containers">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 level 2: Containers of IMT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Deployable/runnable units and the files they exchange. Grey boxes are files on disk; dashed boxes are in progress." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="user" value='&lt;b style="font-size:13px"&gt;Support engineer / Developer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Analyses logs in the desktop app.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b_app" value="IMT desktop app  [one Tauri 2 process: native window + WebView2 / WKWebView]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;verticalAlign=top;align=right;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;container=0;imtRole=bg;" vertex="1" parent="1">
          <mxGeometry x="400" y="170" width="700" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value='&lt;b style="font-size:13px"&gt;Angular UI&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Container: Angular 22, TypeScript, NgRx SignalStore, ECharts, dockview]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Shell, timeline, events grid, inspector, metrics, profile editor, plugin views. Reaches the engine only through the ImtBackend service.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="shell" value='&lt;b style="font-size:13px"&gt;Tauri shell (imt-app)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Container: Rust, Tauri 2]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Thin async commands over the LogStore trait (open_paths, query_*, save_project, set_live, annotations, ...); validates every IPC argument. One workspace per window (CurrentWindow). Window manager, single instance (--new-window, --new-instance), tray, background tasks, notifications, lifecycle (safe mode, crash marker, per-window sessions in the app data folder); file watcher for live tail; writes the app log.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="500" width="280" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="core" value='&lt;b style="font-size:13px"&gt;imt-core&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Container: Rust library]&lt;/font&gt;&lt;br&gt;&lt;br&gt;The engine: Workspace (LogStore), importers, profiles and pipeline, query + ql, analysis, patterns, exceptions, export, project, live tail, plugin runtime (dependency graph, services, event bus, marker kinds, annotators). In-memory, parallel with rayon.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="840" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="plugins" value='&lt;b style="font-size:13px"&gt;Plugin crates&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Container: Rust crates]&lt;/font&gt;&lt;br&gt;&lt;br&gt;imt-plugin-registry, -windows, -web, -otel, -syslog. Each implements Plugin and is installed by plugins() in the shell.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="840" width="220" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Uses&lt;br&gt;[GUI]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="ui">
          <mxGeometry relative="1" as="geometry">
