        <mxCell id="c47" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[each panel’s effect reads &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;effectiveQuery&lt;/span&gt; and calls on its own]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="88" y="386" width="1176" height="18" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;span style=&quot;font-size:12px&quot;&gt;Every command runs off the UI thread against the window’s store. An import never blocks readers. Page, timeline and chart are not cancelled: the UI ignores stale replies by sequence number.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="566" y="1041" width="380" height="88" as="geometry"/></mxCell>
