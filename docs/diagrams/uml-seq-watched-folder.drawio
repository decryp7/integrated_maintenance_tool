        <mxCell id="c30" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;match_known_issues(report)&lt;/span&gt; over the knowledge files&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="348" y="831" width="367" height="16" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="856" as="sourcePoint"/><mxPoint x="964" y="856" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c32" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;fresh_matches(report)&lt;/span&gt;: only issues not announced before&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="348" y="872" width="384" height="16" as="geometry"/></mxCell>
        <mxCell id="c33" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="897" as="sourcePoint"/><mxPoint x="548" y="897" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c34" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Post one notice for each new match&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="348" y="913" width="233" height="16" as="geometry"/></mxCell>
