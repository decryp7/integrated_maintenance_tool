        <mxCell id="c43" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[every 5 s, until the window closes]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="88" y="375" width="1176" height="18" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;span style=&quot;font-size:12px&quot;&gt;Files over 4 GiB are reported once and left alone. The list of folders is saved with the project and applied again when it opens. &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief watch&lt;/span&gt; uses the same state machine in the command line.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="358" y="1011" width="380" height="88" as="geometry"/></mxCell>
