        <mxCell id="c35" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;line;strokeWidth=1;strokeColor=#3869BB;fillColor=none;dashed=1;dashPattern=4 4;" parent="1" vertex="1"><mxGeometry x="420" y="646" width="940" height="8" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;outputs(name)&lt;/span&gt; / list &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.blg&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.csv&lt;/span&gt; and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.tsv&lt;/span&gt; files under the root and output paths (depth ≤ 4), newest first; &lt;i&gt;Import results&lt;/i&gt; opens them in IMT and starts live tail when enabled" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;fontSize=11;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="440" y="660" width="900" height="48" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;b&gt;Errors&lt;/b&gt;: a failed &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;logman&lt;/span&gt; call leaves the state unchanged and the view shows the &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PerfmonError&lt;/span&gt;: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Unsupported&lt;/span&gt; (not Windows; nothing runs), &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;AccessDenied&lt;/span&gt; (run elevated), &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Invalid&lt;/span&gt; (bad set name), &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Io&lt;/span&gt; (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;logman&lt;/span&gt; did not start or timed out: 120 s, setting &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;tools.logmanTimeout&lt;/span&gt; 5–600 s), &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Failed&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;{code, message}&lt;/span&gt;." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1400" y="160" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;Driver&lt;/b&gt;: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PerfmonController&lt;/span&gt; runs &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;logman&lt;/span&gt; through &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;CommandRunner&lt;/span&gt; and never touches the registry. &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PerfmonView&lt;/span&gt; / &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PerfmonStore&lt;/span&gt; call &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;perfmon_install&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;perfmon_control&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;{start | stop | delete | query}&lt;/span&gt; and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;perfmon_outputs&lt;/span&gt;: compatibility wrappers over the tool &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;perfmon.sets&lt;/span&gt; (Windows only, needs elevation, unavailable in safe mode)." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1400" y="290" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;Wizard&lt;/b&gt;: preset → &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;perfmon_generate&lt;/span&gt; (template XML) → &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;installAndStart&lt;/span&gt; = install, then start." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1400" y="420" width="360" height="54" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b style=&quot;font-size:12px;color:#5A6375&quot;&gt;Legend&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D5D9E0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;container=1;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="770" width="820" height="70" as="geometry"/></mxCell>
        <mxCell id="c41" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;ellipse;fillColor=#1B2130;strokeColor=#1B2130;" parent="c40" vertex="1"><mxGeometry x="26" y="37" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="c42" value="Initial pseudostate" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;" parent="c40" vertex="1"><mxGeometry x="66" y="34" width="144" height="22" as="geometry"/></mxCell>
        <mxCell id="c43" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=6;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;" parent="c40" vertex="1"><mxGeometry x="216" y="35" width="36" height="20" as="geometry"/></mxCell>
        <mxCell id="c44" value="State" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;" parent="c40" vertex="1"><mxGeometry x="266" y="34" width="144" height="22" as="geometry"/></mxCell>
        <mxCell id="c45" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;strokeWidth=1.5;strokeColor=#5A6375;html=1;endArrow=open;endFill=0;endSize=8;" parent="c40" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="416" y="45" as="sourcePoint"/><mxPoint x="454" y="45" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c46" value="event [guard] / action" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;" parent="c40" vertex="1"><mxGeometry x="466" y="34" width="144" height="22" as="geometry"/></mxCell>
        <mxCell id="c47" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=8;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;" parent="c40" vertex="1"><mxGeometry x="620" y="34" width="28" height="22" as="geometry"/></mxCell>
