<mxfile host="app.diagrams.net" agent="IMT docs" version="24.0.0">
  <diagram id="UML-State-PerfMon-collector-set" name="UML State PerfMon collector set">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="UML state machine: a Performance Monitor Data Collector Set driven by IMT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="PerfmonController in crates/imt-plugin-windows (perfmon_control.rs) runs logman through CommandRunner; template from CollectorTemplate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s_tpl" value='&lt;b&gt;Template generated&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;CollectorTemplate.to_xml()&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="120" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s_imp" value='&lt;b&gt;Imported&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;logman import -n NAME -xml&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s_run" value='&lt;b&gt;Running&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;logman start&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
