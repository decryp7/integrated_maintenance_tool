        <mxCell id="c26" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;stop(name)&lt;/span&gt; from the view or tray&lt;br&gt;/ &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;logman stop&lt;/span&gt;; finish task&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;query()&lt;/span&gt; [Stopped]" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="716" y="312" width="330" height="48" as="geometry"/></mxCell>
