        <mxCell id="s_out" value='&lt;b&gt;Output collected&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;output_files(status): CSV / BLG&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
