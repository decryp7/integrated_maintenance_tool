        <mxCell id="c35" value="" style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;line;strokeWidth=1;strokeColor=#3869BB;fillColor=none;dashed=1;dashPattern=4 4;" parent="1" vertex="1"><mxGeometry x="420" y="646" width="940" height="8" as="geometry"/></mxCell>
        <mxCell id="c36" value="outputs(name) / list .blg, .csv and .tsv files under the root and output paths (depth ≤ 4), newest first; &lt;i&gt;Import results&lt;/i&gt; opens them in IMT and starts live tail when enabled" style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;fontSize=11;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="440" y="660" width="900" height="48" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;b&gt;Errors&lt;/b&gt;: a failed logman call leaves the state unchanged and the view shows the PerfmonError: Unsupported (not Windows; nothing runs), AccessDenied (run elevated), Invalid (bad set name), Io (logman did not start or timed out: 120 s, setting tools.logmanTimeout 5–600 s), Failed {code, message}." style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1400" y="160" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;Driver&lt;/b&gt;: PerfmonController runs logman through CommandRunner and never touches the registry. PerfmonView / PerfmonStore call perfmon_install, perfmon_control {start | stop | delete | query} and perfmon_outputs: compatibility wrappers over the tool perfmon.sets (Windows only, needs elevation, unavailable in safe mode)." style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1400" y="290" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;Wizard&lt;/b&gt;: preset → perfmon_generate (template XML) → installAndStart = install, then start." style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1400" y="420" width="360" height="54" as="geometry"/></mxCell>
