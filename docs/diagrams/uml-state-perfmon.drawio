        </mxCell>
        <mxCell id="s_stop" value='&lt;b&gt;Stopped&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;logman stop, or duration elapsed&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="180" height="80" as="geometry"/>
