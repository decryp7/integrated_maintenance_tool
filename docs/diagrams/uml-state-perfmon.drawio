  <diagram id="UML-State-perfmon" name="UML State perfmon">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="910" math="0" shadow="0" background="#FFFFFF">
