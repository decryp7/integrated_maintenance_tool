          <mxGeometry x="0" y="0" width="2500" height="1340" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;IMT — deployment&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="30" width="1000" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;span style=&quot;font-size:12px;color:#5A6375&quot;&gt;UML · Deployment diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="62" width="1000" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;Where IMT’s parts run: the analyst workstation, monitored servers, the Gitea build farm that produces the installers, and the download hosts.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="82" width="1000" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;«device»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Analyst workstation&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Windows 10/11, macOS, Linux]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=cube;size=14;darkOpacity=0.04;darkOpacity2=0.08;strokeColor=#8A93A6;fillColor=#F7F8FA;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=18;container=1;collapsible=0;recursiveResize=0;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="1360" height="840" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:12px;color:#5A6375&quot;&gt;«execution environment» OS webview: WebView2 / WKWebView / WebKitGTK&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#E65F2A;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" parent="1" vertex="1">
          <mxGeometry x="80" y="210" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Angular UI bundle&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«artifact» HTML, JS, CSS in the app bundle]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Strict CSP, no remote content; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ImtBackend&lt;/span&gt; = &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;TauriBackend&lt;/span&gt;.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="100" y="250" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b style=&quot;font-size:12px;color:#5A6375&quot;&gt;«execution environment» imt-app process&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#3869BB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" parent="1" vertex="1">
          <mxGeometry x="80" y="440" width="560" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-app&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» Rust, Tauri 2]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tauri shell with &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-core&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-profile&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-ai&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-pdf&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-store-client&lt;/span&gt; and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-host&lt;/span&gt; linked in; one store per window; tray and single instance.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="100" y="480" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;App data folder&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«folder» per user]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;settings.json&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;sessions/&lt;/span&gt; and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;recovered/&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;stores/&lt;/span&gt; (a folder per window until saved), parser library, profiles, notes, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ai/models&lt;/span&gt; (GGUF), &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ai/runtimes&lt;/span&gt; (llama-server builds), installed plugins, app log (CLEF).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="100" y="760" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b style=&quot;font-size:12px;color:#5A6375&quot;&gt;«execution environment» Child processes, sandboxed and supervised (restart with backoff, quarantine, memory watched, killed with the app)&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#3869BB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" parent="1" vertex="1">
          <mxGeometry x="820" y="210" width="540" height="510" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-plugins&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» Rust, one process per built-in plugin]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Every built-in plugin in its own sandbox (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;--plugin &amp;lt;id&amp;gt;&lt;/span&gt;).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="840" y="270" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Third-party plugin&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» Rust, from a .imtplugin]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Signed package; strictest sandbox, only granted permissions (ADR 0027).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="1100" y="270" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-ai-worker&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» Rust]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Inference worker; starts &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;llama-server&lt;/span&gt; (ADR 0009).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="840" y="410" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;llama-server&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» prebuilt llama.cpp]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Downloaded runtime; runs the GGUF model and its vision projector.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="840" y="580" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-store-worker&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» Rust + libduckdb]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DuckDB stores and Tantivy indexes of all windows (ADR 0014).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1100" y="410" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Invokes commands, events&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Tauri IPC]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="Reads, writes&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;std::fs&lt;/span&gt;]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="Spawns, calls&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-ipc&lt;/span&gt; frames over a private pipe / socket, token]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6863;entryDx=0;entryDy=0;" parent="1" edge="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="Starts, completes&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[HTTP on 127.0.0.1]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c13" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;«device»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Monitored server&lt;/b&gt; &lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Windows Server, Linux, macOS]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=cube;size=14;darkOpacity=0.04;darkOpacity2=0.08;strokeColor=#8A93A6;fillColor=#F7F8FA;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=18;container=1;collapsible=0;recursiveResize=0;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1600" y="130" width="840" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-agent&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«service» Windows SCM, systemd, launchd]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Scheduled and triggered collection.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1640" y="210" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-collect&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» CLI]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Redacted diagnostics bundle.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1910" y="210" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-monitor&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«executable» CLI]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Process and counter sampling.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2180" y="210" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;OS sources&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Event Log, PDH, logman, logs]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;What the agent reads and runs.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="1640" y="400" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Output folder&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[«folder» run folders, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.imtz&lt;/span&gt;, rolling CLEF]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Versioned &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;manifest.json&lt;/span&gt; per run; retention by count, age, size.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1910" y="400" width="510" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="Reads, runs tools&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[with timeouts]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c21" target="c24">
