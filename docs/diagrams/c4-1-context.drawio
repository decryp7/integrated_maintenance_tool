        <mxCell id="c11" value="Monitors and schedules collection&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[GUI, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-agent&lt;/span&gt; CLI / service]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6279;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c6" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Builds, tests and packages plugins&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-api&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;cargo imt-plugin&lt;/span&gt;]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8837;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c7" target="c8">
