<mxfile host="app.diagrams.net" agent="IMT docs" version="24.0.0">
  <diagram id="C4-1---System-Context" name="C4 1 - System Context">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 level 1: System context of IMT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Who uses IMT and which external systems it reads from or talks to. Dashed black border = planned." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p_support" value='&lt;b style="font-size:13px"&gt;Support engineer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Opens customer logs, finds the failing moment, exports a report.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p_dev" value='&lt;b style="font-size:13px"&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Analyses logs from many instances, tunes parsing profiles.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p_admin" value='&lt;b style="font-size:13px"&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Monitors processes and collects diagnostics on servers.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p_author" value='&lt;b style="font-size:13px"&gt;Plugin author&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Extends IMT with importers, transforms and views.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="imt" value='&lt;b style="font-size:13px"&gt;IMT - Integrated Maintenance Tool&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Software System: desktop app + CLIs]&lt;/font&gt;&lt;br&gt;&lt;br&gt;An IDE for analysing logs and diagnostic files: merges logs from many machines into one timeline, with filtering, query language, anomaly and pattern detection, metric charts and parsing profiles. Also collects diagnostics (imt-collect) and monitors processes (imt-monitor).' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="880" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="Opens logs, inspects&lt;br&gt;events [GUI]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1023;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_support" target="imt">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Analyses, writes&lt;br&gt;profiles [GUI]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3523;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_dev" target="imt">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Runs CLI collectors&lt;br&gt;[imt-monitor, imt-collect]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.6023;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_admin" target="imt">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Writes plugins&lt;br&gt;[Rust crates, Angular]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8523;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_author" target="imt">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="x_apps" value='&lt;b style="font-size:13px"&gt;Log-producing applications&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Serilog, log4net, NLog, ...]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Write log files (text, CLEF/JSON, CSV) that IMT reads.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="x_perf" value='&lt;b style="font-size:13px"&gt;Windows Performance Monitor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[logman / relog, PDH]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Collects counters to CSV/BLG; IMT drives collector sets and reads results.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="x_win" value='&lt;b style="font-size:13px"&gt;Windows event log, msinfo32, registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[evtx, .nfo, .reg]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Diagnostic data read by the Windows and Registry plugins.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="x_gitea" value='&lt;b style="font-size:13px"&gt;Gitea&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Gitea Actions]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Hosts source, runs CI and publishes releases with installers.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="680" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="x_seq" value='&lt;b style="font-size:13px"&gt;Seq / Elasticsearch / Loki&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[HTTP APIs (planned)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Remote log stores to query as sources.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#222222;fontColor=#FFFFFF;fontSize=11;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="680" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="x_ai" value='&lt;b style="font-size:13px"&gt;Claude API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[HTTPS (planned, opt-in)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Explains incidents; only redacted data, only with consent.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#222222;fontColor=#FFFFFF;fontSize=11;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="680" width="220" height="130" as="geometry"/>
        </mxCell>
