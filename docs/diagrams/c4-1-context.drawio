        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Support engineer&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Person]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Opens customer logs and bundles and finds the cause of an incident.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=mxgraph.c4.person2;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;align=center;verticalAlign=bottom;spacingBottom=10;spacingLeft=8;spacingRight=8;labelPadding=0;" parent="1" vertex="1">
