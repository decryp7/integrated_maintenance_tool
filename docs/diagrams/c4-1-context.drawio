        <mxCell id="c24" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Hugging Face&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[huggingface.co]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GGUF models for the local AI assistant.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
