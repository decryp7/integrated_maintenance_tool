        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:16px&quot;&gt;IMT — Integrated Maintenance Tool&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Software system: desktop app, Rust + Tauri 2 + Angular 22]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Imports logs, event logs, performance counters, dumps and profiler captures once into a DuckDB store and correlates them on one timeline; live tail, analysis, reports, profiling, notes, a local AI assistant; plus the headless &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-agent&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-monitor&lt;/span&gt; and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-collect&lt;/span&gt; tools.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="480" y="450" width="860" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Opens logs and bundles, investigates&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[GUI]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1163;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c4" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Analyses logs and captures, writes profiles&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[GUI]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;fontSize=11;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3721;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c5" target="c8">
