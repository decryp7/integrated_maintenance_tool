<mxfile host="app.diagrams.net" agent="IMT docs" version="24.0.0">
  <diagram id="Store protocol (one port table)" name="Store protocol (one port table)">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2000" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Store protocol (one port table)&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="30" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;span style=&quot;font-size:12px;color:#5A6375&quot;&gt;UML · Component diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="62" width="1100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;store_port_table!&lt;/span&gt; in &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-store-client&lt;/span&gt; is the single list of every port method that crosses to the store worker; three callbacks expand it (ADR 0042).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="82" width="1500" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt_core::ports&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Rust traits]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Fourteen port traits (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Ingest&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Query&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Positions&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Analysis&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Profiles&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Diagnostics&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Search&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Projects&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Inspect&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Maintain&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Console&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Redaction&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Skew&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Tail&lt;/span&gt;), combined as &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Store&lt;/span&gt;.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="200" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;store_port_table!&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[port_table.rs: the one declarative table]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Per port, one row per method: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;call&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;long&lt;/span&gt; (long timeout) and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;analysis&lt;/span&gt; (cancellable, streams &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;QueryProgress&lt;/span&gt;) take DTOs only; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;custom&lt;/span&gt; rows name a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;remote_*&lt;/span&gt; client handler and a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;serve_*&lt;/span&gt; worker handler. &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;WIRE_VERSION&lt;/span&gt; = 1.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="520" y="180" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;store_ops_enum!&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[StoreOp (protocol.rs)]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The operation enum; its order is the postcard encoding, so rows are only appended (a test pins the prefix).&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1080" y="100" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;remote_impls!&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[impl Port for RemoteStore (remote_ports.rs)]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Client side: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;RemoteStore&lt;/span&gt; in &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-store-client&lt;/span&gt;, called by the Tauri shell through the ports, sends a request frame per call; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Query::scan&lt;/span&gt; and &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Projects::close&lt;/span&gt; stay in &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;remote_extras!&lt;/span&gt;.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1080" y="260" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-ipc frames&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Length-prefixed postcard]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;OpenStore&lt;/span&gt; carries &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;WIRE_VERSION&lt;/span&gt; in its &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Handle&lt;/span&gt;; the client refuses a worker that reports another version and asks to reinstall.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="1080" y="450" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;worker_dispatch!&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[dispatch.rs (imt-store-worker)]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Worker side: one exhaustive &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;match&lt;/span&gt; over &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;StoreOp&lt;/span&gt;, so a forgotten arm is a compile error.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1080" y="630" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;imt-store-duck&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[DuckStore]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Implements every port over Parquet segments, the DuckDB catalog and the Tantivy index.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1560" y="630" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Every method is a row" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Expands" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Expands" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="p2" target="p4">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Expands" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="p2" target="p5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="685" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="Calls the port" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="p5" target="p6">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="Request frames" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="p4" target="p7">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e8" value="Dispatches" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="p7" target="p5">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="n1" value="&lt;span style=&quot;font-size:11px;color:#1B2130&quot;&gt;Adding a port method: the trait method in &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt_core::ports&lt;/span&gt;, its implementation in the store, and one row in &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;store_port_table!&lt;/span&gt; (append at the end). Reordering or removing an operation bumps &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;WIRE_VERSION&lt;/span&gt; and the snapshot test.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="60" y="860" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ft" value="&lt;span style=&quot;font-size:10px;color:#5A6375&quot;&gt;IMT · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;align=right;" parent="1" vertex="1">
          <mxGeometry x="1740" y="1060" width="220" height="18" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
