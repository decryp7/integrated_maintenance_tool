        <mxCell id="c10" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="248" as="sourcePoint"/><mxPoint x="140" y="332" as="targetPoint"/><Array as="points"><mxPoint x="164" y="248"/><mxPoint x="164" y="332"/></Array></mxGeometry></mxCell>
        <mxCell id="c11" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Canonicalise each path (an error names it); add the root; &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;collect_files&lt;/span&gt; by the profile’s globs, skipping removed and known files&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="172" y="250" width="193" height="80" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;import_files_parallel(files, options)&lt;/span&gt;; the import window is set&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="148" y="348" width="461" height="16" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="373" as="sourcePoint"/><mxPoint x="372" y="373" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c14" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="423" as="sourcePoint"/><mxPoint x="372" y="491" as="targetPoint"/><Array as="points"><mxPoint x="396" y="423"/><mxPoint x="396" y="491"/></Array></mxGeometry></mxCell>
        <mxCell id="c15" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Read (retry while locked), expand zip or gzip, then &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;plan(first 64 KiB)&lt;/span&gt;: parser, importer, encoding&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="404" y="425" width="175" height="64" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Chunks of whole lines, or the bytes of a binary file&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="380" y="507" width="322" height="16" as="geometry"/></mxCell>
