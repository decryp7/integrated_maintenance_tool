<mxfile host="drawio" version="32.5.5" compressed="false">
  <diagram id="Debrief — deployment on the analyst workstation" name="Debrief — deployment on the analyst workstation">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;Debrief — deployment on the analyst workstation&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1424" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;UML · Deployment diagram (1 of 3)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1424" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;One app process per instance with a store per window. The store, the plugins, the AI and the helpers run in their own supervised processes.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1424" height="20" as="geometry"/></mxCell>
        <mxCell id="m" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;«device» Analyst workstation [Windows 10 / 11 · macOS · Linux]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="144" width="1424" height="688" as="geometry"/></mxCell>
        <mxCell id="wv" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;«execution environment» OS webview&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="72" y="192" width="312" height="176" as="geometry"/></mxCell>
        <mxCell id="ui" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Angular UI bundle&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«artifact» HTML, JS, CSS in the app]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Strict CSP, no remote content; &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;DebriefBackend&lt;/span&gt; is &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;TauriBackend&lt;/span&gt;.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#C24E00,#F07D3A);fillColor=light-dark(#F9EDE6,#382720);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="232" width="264" height="112" as="geometry"/></mxCell>
        <mxCell id="ap" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;«execution environment» App process&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="72" y="424" width="312" height="200" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;debrief-app&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» Rust, Tauri 2]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;The shell with &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief-core&lt;/span&gt;, &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief-store-client&lt;/span&gt;, &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief-plugin-host&lt;/span&gt;, &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief-ai&lt;/span&gt;, &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief-video&lt;/span&gt; and &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;chromium-driver&lt;/span&gt; linked in; tray, single instance.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="464" width="264" height="136" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;App data folder&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«folder» per user]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;settings.json&lt;/span&gt;, &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;sessions/&lt;/span&gt;, &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;stores/&lt;/span&gt; (a folder per window), parser library, profiles, notes, &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;ai/&lt;/span&gt; models and runtimes, installed plugins, the app log.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="72" y="680" width="312" height="128" as="geometry"/></mxCell>
        <mxCell id="kids" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;«execution environment» Child processes [supervised: restarted with back-off, killed with the app]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="528" y="192" width="920" height="584" as="geometry"/></mxCell>
        <mxCell id="pl" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;debrief-plugins&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» Rust, one process per built-in plugin]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Each plugin in its own sandbox: &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;--plugin &amp;lt;id&amp;gt;&lt;/span&gt;.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#B0508A,#D98BC0);fillColor=light-dark(#F7EEF3,#342A35);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="552" y="232" width="424" height="112" as="geometry"/></mxCell>
        <mxCell id="tp" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Third-party plugin&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» Rust, from a &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;.debriefplugin&lt;/span&gt;]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Signed package; strictest sandbox, only the granted permissions.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#B0508A,#D98BC0);fillColor=light-dark(#F7EEF3,#342A35);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="552" y="368" width="424" height="112" as="geometry"/></mxCell>
        <mxCell id="sw" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;debrief-store-worker&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» Rust + libduckdb]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;DuckDB stores and Tantivy indexes of all windows; 2 GiB hard cap.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="552" y="504" width="424" height="112" as="geometry"/></mxCell>
        <mxCell id="ff" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;ffmpeg, ffprobe&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» pinned LGPL runtime]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Frame passes for video sources: no network, memory-capped.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="552" y="640" width="424" height="112" as="geometry"/></mxCell>
        <mxCell id="aw" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;debrief-ai-worker&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» Rust]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Inference worker; starts &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;llama-server&lt;/span&gt;.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1000" y="232" width="424" height="112" as="geometry"/></mxCell>
        <mxCell id="ll" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;llama-server&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» prebuilt llama.cpp]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Downloaded runtime: the GGUF model and its vision projector.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1000" y="368" width="424" height="112" as="geometry"/></mxCell>
        <mxCell id="ch" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Chromium&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[«executable» Edge · Chrome · Chromium]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Driven over DevTools for research; off screen unless shown.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1000" y="504" width="424" height="112" as="geometry"/></mxCell>
        <mxCell id="sb" value="&lt;span style=&quot;font-size:12px&quot;&gt;Sandbox: Windows AppContainer or low integrity with a job object; Linux landlock and seccomp; macOS sandbox profile.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="424" height="112" as="geometry"/></mxCell>
