        <mxCell id="c67" value="" style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=open;endFill=0;endSize=8;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="c63" target="c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c68" value="resume()" style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1200" y="1188" width="120" height="18" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;b&gt;Timing&lt;/b&gt; (setting liveTailDebounce, default 750 ms, applied at the next start): quiet_ms = min(d, 100), max_delay_ms = d, min_interval_ms = max(d, 250); tick 1 s; poll interval 2 s (100 ms .. 10 min). WatchPreference auto picks polling for network paths, otherwise events." style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="170" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;b&gt;Per tailed file&lt;/b&gt; TailFileState: Tailing | Rotated | Truncated | Deleted | Whole | Error. Identity (inode or file index) detects rotation; deletedFiles keep | drop; an unterminated last line is parsed after carryFlushMs (2 s); retention by maxRecords / maxAgeMs." style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="280" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="c71" value="&lt;b&gt;Profile [live]&lt;/b&gt;: alerts = error_spike, silence, crash, slow_outlier, rate_change, memory_growth; silence_after 60s, cooldown 5m, window 5m, clock data | wall; [[live.rule]] {name, when (QL), threshold, window, severity}. Detectors run when records were inserted, at most every detectEveryMs (1 s); rules and silences on every batch." style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="390" width="430" height="106" as="geometry"/></mxCell>
        <mxCell id="c72" value="&lt;b&gt;Notifications&lt;/b&gt; (notify.rs): only when the window is not seen; level Off | Alerts | All; at most 1 per kind per 30 s and 5 per 300 s." style="fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Aital%2Cwght%400%2C400%3B0%2C700%3B1%2C400%26display%3Dblock;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="516" width="430" height="60" as="geometry"/></mxCell>
