        <mxCell id="c60" value="&lt;b style=&quot;font-size:13px&quot;&gt;Timeline follow (UI · &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;LiveFollowStore&lt;/span&gt;)&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#F7F9FD;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" parent="1" vertex="1"><mxGeometry x="980" y="1030" width="400" height="320" as="geometry"/></mxCell>
