        <mxCell id="c62" value="&lt;b style=&quot;font-size:13px&quot;&gt;Following&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1080" y="1090" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="c63" value="&lt;b style=&quot;font-size:13px&quot;&gt;Holding&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1"><mxGeometry x="1080" y="1250" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="c64" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=open;endFill=0;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c61" target="c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c65" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=open;endFill=0;endSize=8;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c62" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c66" value="zoom / pan,&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;pause()&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=right;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="994" y="1180" width="128" height="32" as="geometry"/></mxCell>
        <mxCell id="c67" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=open;endFill=0;endSize=8;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="c63" target="c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c68" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;resume()&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="1200" y="1188" width="120" height="18" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;b&gt;Timing&lt;/b&gt; (setting &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;liveTailDebounce&lt;/span&gt;, default 750 ms, applied at the next start): &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;quiet_ms&lt;/span&gt; = &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;min(d, 100)&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;max_delay_ms&lt;/span&gt; = d, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;min_interval_ms&lt;/span&gt; = &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;max(d, 250)&lt;/span&gt;; tick 1 s; poll interval 2 s (100 ms – 10 min). &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;WatchPreference&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;auto&lt;/span&gt; picks polling for network paths, otherwise events." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="170" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;b&gt;Per tailed file&lt;/b&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;TailFileState&lt;/span&gt;: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Tailing&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Rotated&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Truncated&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Deleted&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Whole&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Error&lt;/span&gt;. Identity (inode or file index) detects rotation; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;deletedFiles&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;keep&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;drop&lt;/span&gt;; an unterminated last line is parsed after &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;carryFlushMs&lt;/span&gt; (2 s); retention by &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;maxRecords&lt;/span&gt; / &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;maxAgeMs&lt;/span&gt;." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="280" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="c71" value="&lt;i&gt;Alerts and per-file tail status are not computed over the store yet (ADR 0014, 6c follow-up).&lt;/i&gt; &lt;b&gt;Profile&lt;/b&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;[live]&lt;/span&gt;: &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;alerts&lt;/span&gt; = &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;error_spike&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;silence&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;crash&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;slow_outlier&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;rate_change&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;memory_growth&lt;/span&gt;; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;silence_after&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;60s&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;cooldown&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;5m&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;window&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;5m&lt;/span&gt;, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;clock&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;data&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;wall&lt;/span&gt;; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;[[live.rule]]&lt;/span&gt; &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;{name, when (QL), threshold, window, severity}&lt;/span&gt;. Detectors run when records were inserted, at most every &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;detectEveryMs&lt;/span&gt; (1 s); rules and silences on every batch." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="390" width="430" height="146" as="geometry"/></mxCell>
        <mxCell id="c72" value="&lt;b&gt;Notifications&lt;/b&gt; (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;notify.rs&lt;/span&gt;): only when the window is not seen; level &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Off&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Alerts&lt;/span&gt; | &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;All&lt;/span&gt;; at most 1 per kind per 30 s and 5 per 300 s." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1430" y="556" width="430" height="60" as="geometry"/></mxCell>
        <mxCell id="c73" value="&lt;b style=&quot;font-size:12px;color:#5A6375&quot;&gt;Legend&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#D5D9E0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;container=1;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="1390" width="820" height="100" as="geometry"/></mxCell>
        <mxCell id="c74" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;ellipse;fillColor=#1B2130;strokeColor=#1B2130;" parent="c73" vertex="1"><mxGeometry x="26" y="37" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="c75" value="Initial pseudostate" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;" parent="c73" vertex="1"><mxGeometry x="66" y="34" width="144" height="22" as="geometry"/></mxCell>
        <mxCell id="c76" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;ellipse;shape=endState;fillColor=#1B2130;strokeColor=#1B2130;strokeWidth=1.5;" parent="c73" vertex="1"><mxGeometry x="225" y="36" width="18" height="18" as="geometry"/></mxCell>
