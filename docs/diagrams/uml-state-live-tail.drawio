        </mxCell>
        <mxCell id="e4" value="emit imt://workspace-changed&lt;br&gt;(UI reloads timeline, page, charts)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_ref" target="s_on">
          <mxGeometry relative="1" as="geometry">
