          <mxGeometry x="40" y="10" width="1100" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="set_live(enabled) in app/src-tauri: a debounced file watcher re-imports changed files and emits imt://workspace-changed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s_off" value='&lt;b&gt;Off&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;no watcher&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="160" width="200" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="s_on" value='&lt;b&gt;On&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;debouncer (750 ms) watches opened roots&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="240" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="s_ref" value='&lt;b&gt;Refreshing&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;apply_changes: Workspace::refresh_files(paths)&lt;/font&gt;' style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="160" width="260" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="init" target="s_off">
          <mxGeometry relative="1" as="geometry">
