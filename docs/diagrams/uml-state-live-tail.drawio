        <mxCell id="e2" value="set_live(true)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=1.0000;exitY=0.3571;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3571;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_off" target="s_on">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="files changed or created" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=11;jettySize=auto;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=1.0000;exitY=0.3571;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3571;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_on" target="s_ref">
          <mxGeometry relative="1" as="geometry">
