              <mxCell id="n6" value="A third-party plugin is a signed &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.imtplugin&lt;/span&gt; (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-package&lt;/span&gt;: manifest, program per target, Ed25519 signature checked against the trusted keys); &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Builtins::add_installed&lt;/span&gt; adds its process." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="c136" vertex="1"><mxGeometry x="1720" y="695" width="250" height="90" as="geometry"/></mxCell>
              <mxCell id="n7" value="&lt;span style=&quot;color:#5A6375&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-dotnet&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;DotnetPlugin&lt;/span&gt;&lt;/b&gt;&lt;br&gt;tool dotnet-profiler: ETW and EventPipe recordings written as NetTrace (ADR 0019)" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=folder;tabWidth=110;tabHeight=14;tabPosition=left;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=18;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="1490" width="418" height="100" as="geometry"/></mxCell>
              <mxCell id="n8" value="&lt;span style=&quot;color:#5A6375&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-native&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;NativePlugin&lt;/span&gt;&lt;/b&gt;&lt;br&gt;native profiling tools (suspend-and-sample, ETW) and the ETL importer (ADR 0022)" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=folder;tabWidth=110;tabHeight=14;tabPosition=left;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=18;fontSize=11;" parent="1" vertex="1"><mxGeometry x="498" y="1490" width="418" height="100" as="geometry"/></mxCell>
              <mxCell id="n9" value="&lt;span style=&quot;color:#5A6375&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-dumps&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;DumpsPlugin&lt;/span&gt;&lt;/b&gt;&lt;br&gt;document importers: minidumps and UMDH logs; the Create dump tool (ADR 0023)" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=folder;tabWidth=110;tabHeight=14;tabPosition=left;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=18;fontSize=11;" parent="1" vertex="1"><mxGeometry x="936" y="1490" width="418" height="100" as="geometry"/></mxCell>
              <mxCell id="n10" value="&lt;span style=&quot;color:#5A6375&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-package&lt;/span&gt; · &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-plugin-api&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.imtplugin&lt;/span&gt; · &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;serve&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Third-party plugins: signed package, the SDK &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;serve(Arc&amp;lt;dyn Plugin&amp;gt;)&lt;/span&gt; and the protocol version in the handshake (ADR 0027)." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=folder;tabWidth=110;tabHeight=14;tabPosition=left;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=18;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1374" y="1490" width="418" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
