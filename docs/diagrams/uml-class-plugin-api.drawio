        <mxCell id="traits" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;Contribution traits (debrief_plugin_api)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="448" y="144" width="800" height="744" as="geometry"/></mxCell>
        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;Plugin API — what a plugin implements&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1376" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;UML · Class diagram (1 of 3)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1376" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;A plugin depends on &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief-plugin-api&lt;/span&gt; alone. Its &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;register&lt;/span&gt; adds contributions; &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;serve&lt;/span&gt; answers the host over &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;debrief-ipc&lt;/span&gt; in a sandboxed process (ADR 0017).&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1376" height="20" as="geometry"/></mxCell>
        <mxCell id="srv" value="&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;«function»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:600;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace&quot;&gt;serve&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="48" y="144" width="328" height="128" as="geometry"/></mxCell>
