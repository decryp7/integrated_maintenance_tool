        <mxCell id="note_pl" value="Every importer below a plugin is registered by that plugin in register() with add_importer / add_binary_importer; ProcessMonitor with add_collector. Built-in importers are registered by Importers::new(). Importers are chosen by sniff() confidence (binary importers first), or forced by parse.format. MonitorPlugin is not installed by the desktop shell; it is used by the imt-monitor CLI." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
