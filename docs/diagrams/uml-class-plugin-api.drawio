  <diagram id="UML-Class-plugin-API" name="UML Class plugin API">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2300" pageHeight="1830" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Plugin API and implementations&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;span style=&quot;font-size:12px;color:#5A6375&quot;&gt;UML · Class diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt_core::plugin&lt;/span&gt;: a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Plugin&lt;/span&gt; registers contributions in the &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PluginRegistry&lt;/span&gt;, which wraps each one in a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Guarded*&lt;/span&gt; adapter. Every built-in and third-party plugin runs out of process behind &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;RemotePlugin&lt;/span&gt; (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-ipc&lt;/span&gt; frames, ADR 0017); no plugin runs in the app process.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="82" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;«interface»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace&quot;&gt;Plugin&lt;/span&gt;&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;align=center;verticalAlign=top;spacingTop=5;" parent="1" vertex="1"><mxGeometry x="40" y="150" width="340" height="159" as="geometry"/></mxCell>
        <mxCell id="c5" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;line;strokeWidth=1;strokeColor=#A664FE;fillColor=none;" parent="1" vertex="1"><mxGeometry x="40" y="190" width="340" height="8" as="geometry"/></mxCell>
