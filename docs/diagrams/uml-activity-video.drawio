<mxfile host="app.diagrams.net" agent="IMT docs" version="24.0.0">
  <diagram id="Video source pipeline" name="Video source pipeline">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2300" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="fontFamily=Arial,Helvetica,sans-serif;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="2300" height="900" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Video source pipeline&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="30" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;span style=&quot;font-size:12px;color:#5A6375&quot;&gt;UML · Activity diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="62" width="1100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;From a recording to events on the timeline: sandboxed FFmpeg passes, a pure frame selection, alignment and the vision model (ADR 0033).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="82" width="1500" height="18" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Open a video&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[File ▸ Open or drop]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Sniffed by signature; the player gets the file through a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;media:&lt;/span&gt; scheme.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="300" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Runtime ready?&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Settings ▸ Video]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Pinned LGPL build, or a user-provided &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ffmpeg&lt;/span&gt;; both pass the self-test before use.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="380" y="300" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Install runtime&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[job, SHA-256]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Download, unpack defensively, self-test on a generated clip, then rename into place; rollback kept.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="380" y="110" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;ffprobe&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[sandboxed process]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Duration, size and container time; limits: 6 h, 30 s probe timeout.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="700" y="300" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pass 1: candidates&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;mpdecimate&lt;/span&gt; + scene score]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Scaled to 256 px; drops blinking cursors and clocks; scores every remaining frame.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="1020" y="300" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Select frames&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt_video::select&lt;/span&gt; (pure)]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;First and last always; threshold rises until at most 30 (max 120); or one per interval.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1340" y="300" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Pass 2: extract&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[PNG, at most 1 366 px]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Decodes exactly the selected times; each PNG is re-encoded in Rust.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#8A93A6;fillColor=#EEF0F3;spacing=8;align=center;verticalAlign=middle;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="1660" y="300" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Frame strip&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[Video view]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Drop frames, add the current one, switch mode and analyse again.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#E65F2A;fillColor=#FCE9E1;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1660" y="520" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Align to the logs&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt_video::align&lt;/span&gt; (pure)]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;User start, on-screen clock, file name, container time, file time; with confidence.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1340" y="520" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Describe frames&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[AI job, vision model]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;One request per kept frame; screen text is data, never instructions.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#A664FE;fillColor=#F2E8FF;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1020" y="520" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Write &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.frames&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[videos/&amp;lt;key&amp;gt;/ in the project]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Versioned &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;video.json&lt;/span&gt;, frames and the frames source; the video is referenced by SHA-256.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="700" y="520" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;VideoFramesImporter&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[one event per frame]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Own lane (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Video&lt;/span&gt;); timeline, search, Moment, notes and SQL work unchanged.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="380" y="520" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f0" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f1" value="no" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f2" value="yes" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a2" target="a4">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f3" value="installed" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f4" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f5" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a5" target="a6">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f6" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a6" target="a7">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f7" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a7" target="a8">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f8" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a8" target="a9">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f9" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a9" target="a10">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f10" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a10" target="a11">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="f11" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;align=center;" parent="1" edge="1" source="a11" target="a12">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="n1" value="&lt;span style=&quot;font-size:11px;color:#1B2130&quot;&gt;Every FFmpeg run: empty environment, no network, reads only the runtime folder and the chosen video, writes only a fresh temporary folder, memory-capped, wall-clock-limited and cancellable from the Jobs pane. A model without vision is never sent images (&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;NoVision&lt;/span&gt;).&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="60" y="720" width="2100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ft" value="&lt;span style=&quot;font-size:10px;color:#5A6375&quot;&gt;IMT · updated 2026-10-22&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;align=right;" parent="1" vertex="1">
          <mxGeometry x="2040" y="860" width="220" height="18" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
