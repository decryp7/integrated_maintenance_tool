<mxfile host="drawio" version="32.5.5" compressed="false">
  <diagram id="Ingest — from a file to records" name="Ingest — from a file to records">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;Ingest — from a file to records&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1184" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;UML · Activity diagram (1 of 2)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1184" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;In the store worker, one file at a time, under &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;guard::catch&lt;/span&gt;. Every failure lists the file as unrecognised with its reason; the rest of the import continues.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1184" height="20" as="geometry"/></mxCell>
        <mxCell id="st" value="" style="ellipse;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="288" y="152" width="16" height="16" as="geometry"/></mxCell>
        <mxCell id="reg" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;«iterative»  each entry&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="72" y="264" width="448" height="400" as="geometry"/></mxCell>
        <mxCell id="rd" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Read the bytes&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;read_with_retry&lt;/span&gt;: four retries while the file is locked.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="200" width="400" height="64" as="geometry"/></mxCell>
        <mxCell id="ex" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Expand an archive&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;archive::expand&lt;/span&gt; for zip and gzip: at most 1 GiB an entry and 4 GiB in all.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="304" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="pl" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Plan from the first 64 KiB&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;The parser library picks a parser, then the importer and the text encoding (BOM, detection or the source’s own choice).&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="424" width="400" height="96" as="geometry"/></mxCell>
        <mxCell id="im" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Read the events&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;The importer reads 8 MiB chunks of whole lines; lines over 4 MiB are skipped. A binary importer reads the bytes.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="96" y="560" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="en" value="" style="ellipse;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=none;" vertex="1" parent="1"><mxGeometry x="284" y="720" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="ellipse;strokeWidth=0;fillColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="290" y="726" width="12" height="12" as="geometry"/></mxCell>
        <mxCell id="sink" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;List as unrecognised&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;UnrecognizedFile&lt;/span&gt;: path, name, reason]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Shown in the import summary with its reason. The other files still import. A panic becomes “crashed (please report this file)”.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="688" y="200" width="296" height="464" as="geometry"/></mxCell>
