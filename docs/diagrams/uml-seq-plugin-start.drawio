        <mxCell id="c36" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="821" as="sourcePoint"/><mxPoint x="776" y="821" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c37" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;Welcome&lt;/span&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="784" y="837" width="63" height="16" as="geometry"/></mxCell>
        <mxCell id="c38" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="862" as="sourcePoint"/><mxPoint x="1080" y="862" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c39" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;Manifest&lt;/span&gt; (the id must match), marker kinds, settings section&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="784" y="878" width="395" height="16" as="geometry"/></mxCell>
        <mxCell id="c40" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="903" as="sourcePoint"/><mxPoint x="776" y="903" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c41" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="776" y="953" as="sourcePoint"/><mxPoint x="776" y="1005" as="targetPoint"/><Array as="points"><mxPoint x="800" y="953"/><mxPoint x="800" y="1005"/></Array></mxGeometry></mxCell>
        <mxCell id="c42" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;The plugin is &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;Unavailable&lt;/span&gt;; the supervisor restarts it with back-off, at most three crashes in ten minutes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="808" y="955" width="263" height="48" as="geometry"/></mxCell>
        <mxCell id="c43" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="923" width="1156" height="98" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;opt&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="929" width="40" height="18" as="geometry"/></mxCell>
        <mxCell id="c45" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[the process does not start]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="102" y="929" width="1092" height="18" as="geometry"/></mxCell>
        <mxCell id="c46" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="643" width="1184" height="386" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;loop&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="649" width="40" height="18" as="geometry"/></mxCell>
        <mxCell id="c48" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[each built-in plugin, started in parallel]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="88" y="649" width="1120" height="18" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;span style=&quot;font-size:12px&quot;&gt;Frames are length-prefixed postcard on an owner-only named pipe or Unix socket, never TCP. The sandbox is an AppContainer or low integrity with a job object on Windows, landlock and seccomp on Linux, a sandbox profile on macOS.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="880" y="1037" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="1208" width="452" height="40" as="geometry"/></mxCell>
