        <mxCell id="c18" value="" style="rounded=1;absoluteArcSize=1;arcSize=4;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);" vertex="1" parent="1"><mxGeometry x="64" y="940" width="28" height="16" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Action&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="100" y="939" width="45" height="18" as="geometry"/></mxCell>
