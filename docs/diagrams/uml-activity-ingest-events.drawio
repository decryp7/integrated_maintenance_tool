        <mxCell id="c21" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Note&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="205" y="939" width="34" height="18" as="geometry"/></mxCell>
        <mxCell id="c22" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="263" y="948" as="sourcePoint"/><mxPoint x="291" y="948" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c23" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Control flow&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="299" y="939" width="84" height="18" as="geometry"/></mxCell>
        <mxCell id="footer" value="&lt;span style=&quot;font-size:11px;font-weight:400&quot;&gt;Debrief · updated 2026-10-23&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=right;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="840" y="939" width="360" height="18" as="geometry"/></mxCell>
