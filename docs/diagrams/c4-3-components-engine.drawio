              <mxCell id="n84" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;survey&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#5A6375&quot;&gt;[FolderSurvey]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Samples sources and proposes parsers; each is validated.&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#29A077;fillColor=#E0F2EC;spacing=8;align=center;verticalAlign=middle;" parent="1" vertex="1">
