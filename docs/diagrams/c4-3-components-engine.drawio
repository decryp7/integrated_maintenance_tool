        <mxCell id="title" value="C4 level 3: Components of imt-core (engine)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Modules under crates/imt-core/src. Arrows point from user to used; the Workspace orchestrates the others (the bottom row through workspace/*.rs). Every component uses model (Record, Level)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="b_core" value="imt-core  [Container: Rust library]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#666666;fontSize=12;verticalAlign=top;align=right;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;container=0;imtRole=bg;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="1800" height="1195" as="geometry"/>
        </mxCell>
        <mxCell id="shell" value='&lt;b style="font-size:13px"&gt;Tauri shell&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Container: Rust, Tauri 2]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Commands call the LogStore trait and ProjectFile on the calling window&#39;s workspace (CurrentWindow). Window manager, tray, background tasks, single instance and notifications stay in the shell; it publishes SnapshotTaken and calls shutdown_plugins when a window closes or the app exits.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="200" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="api" value='&lt;b style="font-size:13px"&gt;api&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Component: Rust, api.rs]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Wire DTOs: PageRequest, WorkspaceSummary, SourceInfo, MomentRequest, ...' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="410" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="store" value='&lt;b style="font-size:13px"&gt;store&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;[Component: Rust, store.rs]&lt;/font&gt;&lt;br&gt;&lt;br&gt;LogStore trait: the port the shell depends on (open, page, timeline, ...).' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="580" width="240" height="100" as="geometry"/>
        </mxCell>
