  <diagram id="UML-Sequence-plugin-registration" name="UML Sequence plugin registration">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1960" pageHeight="2634" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Plugin registration at start-up&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;span style=&quot;font-size:12px;color:#5A6375&quot;&gt;UML · Sequence diagram&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="62" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;span style=&quot;font-size:11px;color:#5A6375&quot;&gt;Each window builds a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;PluginRegistry&lt;/span&gt;: every built-in plugin runs in its own sandboxed process and talks to the host over &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;imt-ipc&lt;/span&gt; (postcard frames on a private local stream, ADR 0017); every contribution is wrapped in a &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;Guarded*&lt;/span&gt; adapter before the window’s Host compiles the profile.&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="82" width="1100" height="18" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b style=&quot;font-size:13px&quot;&gt;AppState&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#5A6375&quot;&gt;[Tauri shell · &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;app_state.rs&lt;/span&gt;]&lt;/i&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=8;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;spacing=8;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1"><mxGeometry x="35.0" y="130" width="190" height="56" as="geometry"/></mxCell>
