        <mxCell id="c28" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;changed: restart&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="57" y="156" width="114" height="18" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;span style=&quot;font-size:12px&quot;&gt;A file that vanishes is forgotten. At most 10,000 files are pending and a scan reads at most 50,000 entries, 16 levels deep, without following symbolic links. A new known issue found in the imported data is announced once, or again when it has more events.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="72" y="536" width="1192" height="56" as="geometry"/></mxCell>
