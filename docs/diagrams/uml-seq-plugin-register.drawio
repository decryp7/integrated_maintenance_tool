        <mxCell id="c25" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Wrap each in a &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;Guarded*&lt;/span&gt; (owner = the plugin id); record what it contributes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="372" y="614" width="163" height="64" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;An error or a panic: “crashed”; logged, the next plugin goes on&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="348" y="730" width="392" height="16" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="756" y="755" as="sourcePoint"/><mxPoint x="340" y="755" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c28" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="700" width="1212" height="71" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;opt&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="706" width="40" height="18" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[the plugin registered an error]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="102" y="706" width="1148" height="18" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="334" width="1240" height="445" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;span style=&quot;font-size:11px;font-weight:600&quot;&gt;loop&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="40" height="18" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;[built-ins, then the tools plugin, in this order]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="88" y="340" width="1176" height="18" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;resolve()&lt;/span&gt;: dependencies, then &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;activate()&lt;/span&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="140" y="787" width="284" height="16" as="geometry"/></mxCell>
        <mxCell id="c35" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132" y="812" as="sourcePoint"/><mxPoint x="340" y="812" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c36" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;Host::new(registry, profile)&lt;/span&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="140" y="828" width="226" height="16" as="geometry"/></mxCell>
        <mxCell id="c37" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132" y="853" as="sourcePoint"/><mxPoint x="964" y="853" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c38" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;compile_with(profile, &amp;amp;transforms)&lt;/span&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="972" y="869" width="273" height="16" as="geometry"/></mxCell>
        <mxCell id="c39" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="964" y="894" as="sourcePoint"/><mxPoint x="1172" y="894" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c40" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1172" y="910" as="sourcePoint"/><mxPoint x="1172" y="978" as="targetPoint"/><Array as="points"><mxPoint x="1196" y="910"/><mxPoint x="1196" y="978"/></Array></mxGeometry></mxCell>
        <mxCell id="c41" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;A plugin pipeline step needs an installed transform id, or it is a profile error&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="1204" y="912" width="151" height="64" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;CompiledProfile&lt;/span&gt;, or the error naming the step&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="972" y="994" width="313" height="16" as="geometry"/></mxCell>
        <mxCell id="c43" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=open;endFill=0;endSize=6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1172" y="1019" as="sourcePoint"/><mxPoint x="964" y="1019" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c44" value="" style="edgeStyle=none;rounded=1;html=1;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);endArrow=block;endFill=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="964" y="1035" as="sourcePoint"/><mxPoint x="964" y="1103" as="targetPoint"/><Array as="points"><mxPoint x="988" y="1035"/><mxPoint x="988" y="1103"/></Array></mxGeometry></mxCell>
        <mxCell id="c45" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;&lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;load_profile&lt;/span&gt;: the saved profile is kept when &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;validate_profile&lt;/span&gt; passes&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="996" y="1037" width="169" height="64" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;span style=&quot;font-size:12px&quot;&gt;The guard admits each call, enforces the call kind’s budget (sniff 5 s, import 120 s, transform 250 ms a record, hook 5 s) and turns panics into errors attributed to the plugin. After three panics or overruns the plugin is quarantined until &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;Health::reset&lt;/span&gt;. Remote calls get 0.9 × the budget.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="338" y="1119" width="420" height="104" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="1288" width="584" height="40" as="geometry"/></mxCell>
        <mxCell id="c66" value="" style="rounded=1;absoluteArcSize=1;arcSize=4;strokeWidth=1.5;strokeColor=light-dark(#1D5FD1,#5B9BFF);fillColor=light-dark(#E8EFFA,#202C3F);" vertex="1" parent="1"><mxGeometry x="64" y="1300" width="28" height="16" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;Debrief&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="100" y="1299" width="52" height="18" as="geometry"/></mxCell>
