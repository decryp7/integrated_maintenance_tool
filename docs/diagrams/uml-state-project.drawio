        <mxCell id="c22" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;save()&lt;/span&gt; / &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;saveAs&lt;/span&gt;&lt;br&gt;(picker,&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;OverwriteGuard&lt;/span&gt;)" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="426" y="254" width="110" height="48" as="geometry"/></mxCell>
        <mxCell id="c23" value="/ &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;save_project&lt;/span&gt;&lt;br&gt;(&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.debriefz&lt;/span&gt;); baseline =&lt;br&gt;what was written" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="426" y="324" width="110" height="48" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=open;endFill=0;endSize=8;edgeStyle=none;exitX=0.7791;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;open(path)&lt;/span&gt; [loaded]&lt;br&gt;/ &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;open_project&lt;/span&gt;,&lt;br&gt;restore, &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;markClean&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="720" y="150" width="140" height="64" as="geometry"/></mxCell>
        <mxCell id="c26" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.5;strokeColor=#5A6375;endArrow=open;endFill=0;endSize=8;edgeStyle=none;exitX=0.2558;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" value="&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;new()&lt;/span&gt; / &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;clear_workspace&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;open(session)&lt;/span&gt; / opened as Untitled" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;labelBackgroundColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="270" y="152" width="260" height="32" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;Unsaved changes&lt;/b&gt;: New, Open and Open recent ask Save / Discard / Cancel while dirty (Escape = Cancel); Save continues only if it succeeds. Dirty = sources + tracked UI snapshot + reports differ from the baseline. Closing a window does not ask." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="40" y="590" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;open fails&lt;/b&gt; (cannot read, not a Debrief project, newer format, store locked by another process): error shown, state unchanged. A project is self-contained (store folder + &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;ui.json&lt;/span&gt;, ADR 0014) and opens without the original logs; old &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;.debriefproj&lt;/span&gt; files still open and import their logs again." style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;shape=note;size=12;strokeWidth=1;strokeColor=#8A93A6;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fontColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="480" y="590" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="c30" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;ellipse;fillColor=#1B2130;strokeColor=#1B2130;" parent="1" vertex="1"><mxGeometry x="1070" y="185" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b style=&quot;font-size:13px&quot;&gt;Starting&lt;/b&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;rounded=1;arcSize=14;absoluteArcSize=1;strokeWidth=1.5;strokeColor=#3869BB;fillColor=#E3EAF6;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1120" y="150" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="c32" value="" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;line;strokeWidth=1;strokeColor=#3869BB;fillColor=none;" parent="1" vertex="1"><mxGeometry x="1120" y="178" width="360" height="8" as="geometry"/></mxCell>
        <mxCell id="c33" value="entry / read &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;running.marker&lt;/span&gt;; write own marker;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;rotate()&lt;/span&gt;: last sessions → &lt;span style=&quot;font-family:Consolas,Menlo,monospace;white-space:nowrap&quot;&gt;recovered/&lt;/span&gt;" style="fontFamily=Arial,Helvetica,sans-serif;html=1;whiteSpace=wrap;fontColor=#1B2130;fontSize=11;text;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=8;" parent="1" vertex="1"><mxGeometry x="1120" y="188" width="360" height="48" as="geometry"/></mxCell>
