        <mxCell id="c22" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;new, clear&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="672" y="290" width="73" height="18" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;span style=&quot;font-size:12px&quot;&gt;Unsaved changes: New, Open and Open recent ask Save, Discard or Cancel while the project is dirty (Escape cancels); Save continues only if it succeeds. Closing a window does not ask. Dirty means the sources, the tracked UI snapshot or the reports differ from the baseline.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="48" y="432" width="592" height="88" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-size:12px&quot;&gt;Save writes &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;save_project&lt;/span&gt; as &lt;span style=&quot;font-family:ui-monospace,SF Mono,Cascadia Mono,Consolas,monospace;white-space:nowrap&quot;&gt;.debriefz&lt;/span&gt; and sets the baseline to what was written; Save as goes through the picker and the overwrite guard. Opening fails with a message (cannot read, not a Debrief project, newer format, store locked) and leaves the state unchanged.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="688" y="432" width="592" height="72" as="geometry"/></mxCell>
